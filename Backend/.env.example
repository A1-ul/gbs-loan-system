# ==============================================================================
# GBS LOAN MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# 4-Environment Isolation: development | test | staging | production
# Render.com Exclusive Cloud Deployment (gabosei48@gmail.com)
# ==============================================================================

NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME=GBS Loan Management System
APP_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000

# Authoritative PostgreSQL Connection (Use separate DB per environment!)
# Development: postgresql://postgres:Admin123@localhost:5432/gbs_loan_db?schema=public
# Test:        postgresql://postgres:Admin123@localhost:5432/gbs_loan_test_db?schema=public
# Staging:     Render Managed PostgreSQL (Staging)
# Production:  Render Managed PostgreSQL (Production)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/gbs_loan_db?schema=public

# Redis Cache & BullMQ Queue Engine (Prefer REDIS_URL in Render Production)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cryptographic Token Secrets (Must differ cleanly per environment; never reuse across envs)
JWT_SECRET=replace-with-strong-64-char-tenant-jwt-secret
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=replace-with-strong-64-char-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
DEVELOPER_JWT_SECRET=replace-with-strong-64-char-developer-landlord-secret
VOICE_AUTH_SECRET=replace-with-strong-64-char-voice-token-secret
ENCRYPTION_KEY=replace-with-32-char-aes256-key
ENCRYPTION_IV=replace-with-16-char-iv

# 2FA / TOTP
TOTP_ISSUER=GBS Loan System
TOTP_WINDOW=1

# Mobile Money (MTN MoMo)
MOMO_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=https://gbs-loan-api.onrender.com/api/v1/payments/momo/callback

# National ID Verification (Ghana Card NIA)
GHANA_CARD_API_URL=https://nia-verification-gateway.example/v1
GHANA_CARD_API_KEY=

# Zoom Meetings
ZOOM_API_KEY=
ZOOM_API_SECRET=
ZOOM_ACCOUNT_ID=

# SMS & Email Providers
SMS_PROVIDER=hubtel
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=GBSLoan
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gabosei48@gmail.com
SMTP_PASS=
EMAIL_FROM=gabosei48@gmail.com

# Google Maps / GIS
GOOGLE_MAPS_API_KEY=

# Storage & Automated Backups
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups
CLOUD_BACKUP_ENABLED=false
CLOUD_BACKUP_BUCKET=

# Telemetry & Rate Limiting
METRICS_ENABLED=true
METRICS_PORT=9090
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
GPS_TRACKING_INTERVAL_MS=30000
GPS_OFFLINE_SYNC_ENABLED=true

# Default Loan Parameters
DEFAULT_INTEREST_RATE=15.0
DEFAULT_PENALTY_RATE=5.0
DEFAULT_LOAN_TERM_MONTHS=12
ALLOW_DEV_SEEDERS=true

// GBS Loan Management System - Authoritative Enterprise Database Schema
// PostgreSQL + Prisma ORM (Multi-Tenant, Audited, Provenance-Tracked)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SUPER_ADMIN
  COMPANY_OWNER
  EXECUTIVE_MANAGEMENT
  REGIONAL_MANAGER
  BRANCH_MANAGER
  OPERATIONS_MANAGER
  LOAN_OFFICER
  SENIOR_CREDIT_OFFICER
  CREDIT_ANALYST
  LOAN_UNDERWRITER
  COLLECTIONS
  FIELD_OFFICER
  CUSTOMER_SERVICE
  RECEPTION
  GUARANTOR_PORTAL
  MEMBER_PORTAL
  ACCOUNTANT
  FINANCE_MANAGER
  TREASURY
  HUMAN_RESOURCE
  LEGAL_DEPARTMENT
  COMPLIANCE
  INTERNAL_AUDIT
  RISK_MANAGEMENT
  FRAUD_INVESTIGATION
  SECURITY_OPERATIONS
  MARKETING
  INVESTOR
  BOARD_EXECUTIVE
  MOBILE_STAFF
  MANAGER
  STAFF
  COLLECTOR
  MEMBER
  GUARANTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  AWAITING_APPROVAL
  DEACTIVATED
  REJECTED
}

enum LoanStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  DISBURSED
  ONGOING
  PAID
  OVERDUE
  DEFAULTED
  CLOSED
  REJECTED
}

enum PaymentMethod {
  MOMO
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  AWAITING_APPROVAL
}

enum NotificationType {
  SMS
  EMAIL
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum NotificationCategory {
  PAYMENT_REMINDER
  PAYMENT_DUE_TODAY
  PAYMENT_DUE_WEEK
  OVERDUE_ALERT
  GUARANTOR_ALERT
  LOAN_APPROVED
  LOAN_DISBURSED
  LOAN_REJECTED
  OTP_VERIFICATION
  SYSTEM_ALERT
  MEETING_INVITE
  TENANT_APPROVAL
  TRIAL_COUNTDOWN
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  DISBURSE
  PAYMENT
  EXPORT
  USER_REGISTERED
  USER_QUALIFICATION_VERIFIED
  TENANT_ONBOARDED
  TENANT_APPROVED
  TENANT_REJECTED
  VOICE_VERIFIED
  FACIAL_VERIFIED
  DELETION_REQUESTED
  DELETION_APPROVED
  SYSTEM_LOCK
  SYSTEM_UNLOCK
  BACKUP_CREATED
  MIGRATION_EXECUTED
}

enum SalaryStatus {
  PENDING
  PAID
  CANCELLED
}

enum CollectorStatus {
  ONLINE
  OFFLINE
  ON_ROUTE
  AT_LOCATION
  IDLE
}

enum ConsentType {
  GPS_TRACKING
  DATA_PROCESSING
  MARKETING
  GUARANTOR_AGREEMENT
  PRIVACY_POLICY
  TERMS_OF_SERVICE
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BackupStatus {
  SUCCESS
  FAILED
  IN_PROGRESS
}

enum DataSource {
  PRODUCTION_LIVE
  DEVELOPMENT_SEED
  STAGING_TEST
  MIGRATED_IMPORT
}

enum EnvironmentTag {
  DEVELOPMENT
  TEST
  STAGING
  PRODUCTION
}

// ============================================
// CORE USERS, SECURITY & AUDIT
// ============================================

model User {
  id                    String         @id @default(uuid())
  tenantId              String?        @map("tenant_id")
  branchId              String?        @map("branch_id")
  email                 String         @unique
  username              String?        @map("username")
  phone                 String         @unique
  passwordHash          String         @map("password_hash")
  role                  UserRole
  status                UserStatus     @default(PENDING_VERIFICATION)
  firstName             String         @map("first_name")
  lastName              String         @map("last_name")
  profilePicture        String?        @map("profile_picture")
  address               String?
  gpsLatitude           Float?         @map("gps_latitude")
  gpsLongitude          Float?         @map("gps_longitude")
  isEmailVerified       Boolean        @default(false) @map("is_email_verified")
  isPhoneVerified       Boolean        @default(false) @map("is_phone_verified")
  otpVerified           Boolean        @default(false) @map("otp_verified")
  otpCode               String?        @map("otp_code")
  otpExpiresAt          DateTime?      @map("otp_expires_at")
  twoFactorEnabled      Boolean        @default(false) @map("two_factor_enabled")
  twoFactorSecret       String?        @map("two_factor_secret")
  facialEnrolled        Boolean        @default(false) @map("facial_enrolled")
  facialDescriptorHash  String?        @map("facial_descriptor_hash")
  lastDeviceFingerprint String?        @map("last_device_fingerprint")
  trustedDevices        Json?          @map("trusted_devices")
  qualificationVerified Boolean        @default(false) @map("qualification_verified")
  approvedByAdminId     String?        @map("approved_by_admin_id")
  deletionRequested     Boolean        @default(false) @map("deletion_requested")
  deletionReason        String?        @map("deletion_reason")
  deletionApprovedById  String?        @map("deletion_approved_by_id")
  metadata              Json?
  lastLoginAt           DateTime?      @map("last_login_at")
  lastLoginIp           String?        @map("last_login_ip")
  dataSource            DataSource     @default(PRODUCTION_LIVE) @map("data_source")
  environmentTag        EnvironmentTag @default(DEVELOPMENT) @map("environment_tag")
  isProductionRecord    Boolean        @default(true) @map("is_production_record")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")

  tenant             Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branch             Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberProfile      Member?
  guarantorProfile   Guarantor?
  staffProfile       Staff?
  collectorProfile   Collector?
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  consents           UserConsent[]
  notifications      Notification[]
  verificationLogs   UserVerificationLog[] @relation("UserVerifications")
  adminVerifications UserVerificationLog[] @relation("AdminVerifications")
  voiceProfile       VoiceProfile?

  @@index([tenantId])
  @@index([branchId])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([tenantId, role, status])
  @@map("users")
}

model UserVerificationLog {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  userId       String   @map("user_id")
  adminId      String   @map("admin_id")
  statusBefore String   @map("status_before")
  statusAfter  String   @map("status_after")
  isQualified  Boolean  @map("is_qualified")
  notes        String?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user  User @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  admin User @relation("AdminVerifications", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([adminId])
  @@map("user_verification_logs")
}

model RefreshToken {
  id                String   @id @default(uuid())
  token             String   @unique
  userId            String   @map("user_id")
  deviceFingerprint String?  @map("device_fingerprint")
  ipAddress         String?  @map("ip_address")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserConsent {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  consentType ConsentType @map("consent_type")
  granted     Boolean     @default(false)
  grantedAt   DateTime?   @map("granted_at")
  revokedAt   DateTime?   @map("revoked_at")
  ipAddress   String?     @map("ip_address")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@map("user_consents")
}

model AuditLog {
  id                 String         @id @default(uuid())
  tenantId           String?        @map("tenant_id")
  userId             String?        @map("user_id")
  action             AuditAction
  entityType         String         @map("entity_type")
  entityId           String?        @map("entity_id")
  oldValues          Json?          @map("old_values")
  newValues          Json?          @map("new_values")
  ipAddress          String?        @map("ip_address")
  userAgent          String?        @map("user_agent")
  metadata           Json?
  dataSource         DataSource     @default(PRODUCTION_LIVE) @map("data_source")
  environmentTag     EnvironmentTag @default(DEVELOPMENT) @map("environment_tag")
  isProductionRecord Boolean        @default(true) @map("is_production_record")
  createdAt          DateTime       @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemBackup {
  id           String       @id @default(uuid())
  status       BackupStatus
  filePath     String?      @map("file_path")
  fileSize     BigInt?      @map("file_size")
  cloudPath    String?      @map("cloud_path")
  checksum     String?
  triggeredBy  String?      @map("triggered_by")
  errorMessage String?      @map("error_message")
  startedAt    DateTime     @map("started_at")
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("system_backups")
}

// ============================================
// MEMBERS, GUARANTORS & PRODUCTS
// ============================================

model Member {
  id                  String         @id @default(uuid())
  tenantId            String?        @map("tenant_id")
  branchId            String?        @map("branch_id")
  userId              String         @unique @map("user_id")
  memberNumber        String         @unique @map("member_number")
  ghanaCardNumber     String?        @map("ghana_card_number")
  ghanaCardVerified   Boolean        @default(false) @map("ghana_card_verified")
  ghanaCardVerifiedAt DateTime?      @map("ghana_card_verified_at")
  dateOfBirth         DateTime?      @map("date_of_birth")
  occupation          String?
  employer            String?
  monthlyIncome       Decimal?       @map("monthly_income") @db.Decimal(12, 2)
  emergencyContact    String?        @map("emergency_contact")
  emergencyPhone      String?        @map("emergency_phone")
  creditScore         Int            @default(650) @map("credit_score")
  kycStatus           String         @default("PENDING") @map("kyc_status")
  registrationDate    DateTime       @default(now()) @map("registration_date")
  dataSource          DataSource     @default(PRODUCTION_LIVE) @map("data_source")
  environmentTag      EnvironmentTag @default(DEVELOPMENT) @map("environment_tag")
  isProductionRecord  Boolean        @default(true) @map("is_production_record")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans  Loan[]

  @@index([tenantId])
  @@index([branchId])
  @@index([memberNumber])
  @@map("members")
}

model Guarantor {
  id                   String    @id @default(uuid())
  tenantId             String?   @map("tenant_id")
  userId               String    @unique @map("user_id")
  ghanaCardNumber      String?   @map("ghana_card_number")
  relationship         String?
  agreementSigned      Boolean   @default(false) @map("agreement_signed")
  agreementSignedAt    DateTime? @map("agreement_signed_at")
  penaltyNotifyEnabled Boolean   @default(true) @map("penalty_notify_enabled")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanGuarantors LoanGuarantor[]

  @@index([tenantId])
  @@map("guarantors")
}

model LoanProduct {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  code         String   @unique
  name         String
  category     String   @default("MICRO_LOAN") // MICRO_LOAN, SME_LOAN, GROUP_LOAN, SALARY_LOAN, EMERGENCY_LOAN
  minAmount    Decimal  @default(500) @map("min_amount") @db.Decimal(12, 2)
  maxAmount    Decimal  @default(250000) @map("max_amount") @db.Decimal(12, 2)
  interestRate Decimal  @default(15.0) @map("interest_rate") @db.Decimal(5, 2)
  penaltyRate  Decimal  @default(5.0) @map("penalty_rate") @db.Decimal(5, 2)
  minTermMonths Int     @default(3) @map("min_term_months")
  maxTermMonths Int     @default(36) @map("max_term_months")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("loan_products")
}

// ============================================
// CORE LOAN SYSTEM & COLLATERAL
// ============================================

model Loan {
  id                String         @id @default(uuid())
  tenantId          String?        @map("tenant_id")
  branchId          String?        @map("branch_id")
  loanNumber        String         @unique @map("loan_number")
  memberId          String         @map("member_id")
  loanProductId     String?        @map("loan_product_id")
  principalAmount   Decimal        @map("principal_amount") @db.Decimal(12, 2)
  interestRate      Decimal        @map("interest_rate") @db.Decimal(5, 2)
  penaltyRate       Decimal        @map("penalty_rate") @db.Decimal(5, 2)
  termMonths        Int            @map("term_months")
  totalAmount       Decimal        @map("total_amount") @db.Decimal(12, 2)
  amountPaid        Decimal        @default(0) @map("amount_paid") @db.Decimal(12, 2)
  outstandingAmount Decimal        @map("outstanding_amount") @db.Decimal(12, 2)
  status            LoanStatus     @default(PENDING)
  purpose           String?
  riskScore         Int?           @map("risk_score")
  applicationDate   DateTime       @default(now()) @map("application_date")
  reviewedAt        DateTime?      @map("reviewed_at")
  reviewedById      String?        @map("reviewed_by_id")
  approvedAt        DateTime?      @map("approved_at")
  approvedById      String?        @map("approved_by_id")
  disbursedAt       DateTime?      @map("disbursed_at")
  disbursedById     String?        @map("disbursed_by_id")
  dueDate           DateTime?      @map("due_date")
  closedAt          DateTime?      @map("closed_at")
  rejectionReason   String?        @map("rejection_reason")
  notes             String?
  dataSource        DataSource     @default(PRODUCTION_LIVE) @map("data_source")
  environmentTag    EnvironmentTag @default(DEVELOPMENT) @map("environment_tag")
  isProductionRecord Boolean       @default(true) @map("is_production_record")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant         Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branch         Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  member         Member              @relation(fields: [memberId], references: [id])
  payments       Payment[]
  schedule       RepaymentSchedule[]
  workflowLogs   LoanWorkflowLog[]
  loanGuarantors LoanGuarantor[]
  penalties      LoanPenalty[]
  collaterals    CollateralItem[]

  @@index([tenantId])
  @@index([branchId])
  @@index([memberId])
  @@index([status])
  @@index([applicationDate])
  @@index([dueDate])
  @@map("loans")
}

model CollateralItem {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id")
  loanId         String   @map("loan_id")
  title          String
  assetType      String   @map("asset_type") // PROPERTY, VEHICLE, EQUIPMENT, CASH_DEPOSIT
  estimatedValue Decimal  @map("estimated_value") @db.Decimal(12, 2)
  documentRef    String?  @map("document_ref")
  status         String   @default("VERIFIED")
  verifiedById   String?  @map("verified_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([loanId])
  @@map("collateral_items")
}

model LoanGuarantor {
  id          String   @id @default(uuid())
  loanId      String   @map("loan_id")
  guarantorId String   @map("guarantor_id")
  createdAt   DateTime @default(now()) @map("created_at")

  loan      Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  guarantor Guarantor @relation(fields: [guarantorId], references: [id])

  @@unique([loanId, guarantorId])
  @@map("loan_guarantors")
}

model LoanWorkflowLog {
  id          String     @id @default(uuid())
  loanId      String     @map("loan_id")
  fromStatus  LoanStatus @map("from_status")
  toStatus    LoanStatus @map("to_status")
  performedBy String?    @map("performed_by")
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("loan_workflow_logs")
}

model RepaymentSchedule {
  id            String    @id @default(uuid())
  loanId        String    @map("loan_id")
  installmentNo Int       @map("installment_no")
  dueDate       DateTime  @map("due_date")
  principalDue  Decimal   @map("principal_due") @db.Decimal(12, 2)
  interestDue   Decimal   @map("interest_due") @db.Decimal(12, 2)
  totalDue      Decimal   @map("total_due") @db.Decimal(12, 2)
  amountPaid    Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  isPaid        Boolean   @default(false) @map("is_paid")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([dueDate])
  @@map("repayment_schedules")
}

model LoanPenalty {
  id        String   @id @default(uuid())
  loanId    String   @map("loan_id")
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  appliedAt DateTime @default(now()) @map("applied_at")
  createdAt DateTime @default(now()) @map("created_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("loan_penalties")
}

model Payment {
  id                 String         @id @default(uuid())
  tenantId           String?        @map("tenant_id")
  branchId           String?        @map("branch_id")
  paymentRef         String         @unique @map("payment_ref")
  loanId             String         @map("loan_id")
  amount             Decimal        @db.Decimal(12, 2)
  method             PaymentMethod
  status             PaymentStatus  @default(PENDING)
  momoTransactionId  String?        @map("momo_transaction_id")
  momoPhone          String?        @map("momo_phone")
  bankReference      String?        @map("bank_reference")
  receiptNumber      String?        @map("receipt_number")
  collectedById      String?        @map("collected_by_id")
  approvedById       String?        @map("approved_by_id")
  approvedAt         DateTime?      @map("approved_at")
  notes              String?
  paidAt             DateTime?      @map("paid_at")
  dataSource         DataSource     @default(PRODUCTION_LIVE) @map("data_source")
  environmentTag     EnvironmentTag @default(DEVELOPMENT) @map("environment_tag")
  isProductionRecord Boolean        @default(true) @map("is_production_record")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  loan   Loan    @relation(fields: [loanId], references: [id])

  @@index([tenantId])
  @@index([loanId])
  @@index([status])
  @@index([method])
  @@index([paidAt])
  @@map("payments")
}

// ============================================
// OPERATIONS: STAFF, COLLECTORS, GPS, NOTIFICATIONS, SALARIES
// ============================================

model Staff {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  branchId   String?  @map("branch_id")
  userId     String   @unique @map("user_id")
  employeeId String   @unique @map("employee_id")
  department String?
  position   String?
  hireDate   DateTime @map("hire_date")
  baseSalary Decimal  @map("base_salary") @db.Decimal(12, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant        Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaries      StaffSalary[]
  salaryProfile EmployeeSalaryProfile?

  @@index([tenantId])
  @@index([employeeId])
  @@map("staff")
}

model StaffSalary {
  id         String       @id @default(uuid())
  tenantId   String?      @map("tenant_id")
  staffId    String       @map("staff_id")
  month      Int
  year       Int
  baseAmount Decimal      @map("base_amount") @db.Decimal(12, 2)
  bonuses    Decimal      @default(0) @db.Decimal(12, 2)
  deductions Decimal      @default(0) @db.Decimal(12, 2)
  netAmount  Decimal      @map("net_amount") @db.Decimal(12, 2)
  status     SalaryStatus @default(PENDING)
  paidAt     DateTime?    @map("paid_at")
  paidById   String?      @map("paid_by_id")
  notes      String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, month, year])
  @@index([tenantId])
  @@index([status])
  @@map("staff_salaries")
}

model Collector {
  id             String          @id @default(uuid())
  tenantId       String?         @map("tenant_id")
  branchId       String?         @map("branch_id")
  userId         String          @unique @map("user_id")
  employeeId     String          @unique @map("employee_id")
  assignedZone   String?         @map("assigned_zone")
  status         CollectorStatus @default(OFFLINE)
  lastLatitude   Float?          @map("last_latitude")
  lastLongitude  Float?          @map("last_longitude")
  lastSpeed      Float?          @map("last_speed")
  lastLocationAt DateTime?       @map("last_location_at")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant       Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationLogs CollectorLocationLog[]
  visits       CustomerVisit[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@map("collectors")
}

model CollectorLocationLog {
  id            String          @id @default(uuid())
  collectorId   String          @map("collector_id")
  latitude      Float
  longitude     Float
  speed         Float?

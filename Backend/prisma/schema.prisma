  endDate         DateTime  @map("end_date")
  gracePeriodDays Int       @default(7) @map("grace_period_days")
  autoRenew       Boolean   @default(true) @map("auto_renew")
  lastPaymentAt   DateTime? @map("last_payment_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_subscriptions")
}

model MigrationJob {
  id               String   @id @default(uuid())
  tenantId         String?  @map("tenant_id")
  jobType          String   @map("job_type")
  targetEntity     String   @default("MEMBERS") @map("target_entity")
  fileName         String?  @map("file_name")
  columnMapping    Json?    @map("column_mapping")
  importedIds      Json?    @map("imported_ids")
  totalRecords     Int      @default(0) @map("total_records")
  processedRecords Int      @default(0) @map("processed_records")
  failedRecords    Int      @default(0) @map("failed_records")
  rolledBack       Boolean  @default(false) @map("rolled_back")
  status           String   @default("PENDING")
  errorLog         Json?    @map("error_log")
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([status])
  @@map("migration_jobs")
}

model AIDiagnosticLog {
  id             String   @id @default(uuid())
  issueType      String   @map("issue_type")
  severity       String   @default("INFO")
  description    String
  stackTrace     String?  @map("stack_trace")
  recommendedFix String?  @map("recommended_fix")
  autoFixed      Boolean  @default(false) @map("auto_fixed")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([issueType])
  @@map("ai_diagnostic_logs")
}
